{
    "name": "@kleinkram/backend-common",
    "version": "0.61.0",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "license": "MIT",
    "scripts": {
        "build": "tsc -b && tsc-alias -p tsconfig.json",
        "seed:run": "pnpm build && node dist/scripts/run-seed.js"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.js"
        },
        "./*": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.js",
            "require": "./dist/*.js"
        }
    },
    "peerDependencies": {
        "@nestjs/common": "^12.0.0",
        "@nestjs/core": "^12.0.0",
        "@nestjs/typeorm": "^12.0.0",
        "typeorm": "^1.0.0"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "3.967.0",
        "@aws-sdk/client-sts": "3.967.0",
        "@aws-sdk/s3-request-presigner": "3.967.0",
        "@kleinkram/api-dto": "workspace:*",
        "@kleinkram/shared": "workspace:*",
        "@kleinkram/validation": "workspace:*",
        "@nestjs/schedule": "^12.0.1",
        "@willsoto/nestjs-prometheus": "^6.1.0",
        "axios": "^1.20.0",
        "bull": "^4.16.5",
        "fs-extra": "^11.4.0",
        "ioredis": "^6.0.0",
        "jsonwebtoken": "^9.0.3",
        "minimatch": "^10.2.6",
        "pg": "^8.23.0",
        "prom-client": "^15.1.3",
        "qs": "^6.16.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "typeorm-extension": "^4.1.0"
    },
    "devDependencies": {
        "@faker-js/faker": "^10.6.0",
        "@nestjs/common": "^12.0.1",
        "@nestjs/core": "^12.0.1",
        "@nestjs/typeorm": "^12.0.1",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^24.13.3",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.9.4",
        "tsconfig-paths": "^4.2.0",
        "tsx": "^4.23.13",
        "typeorm": "^1.1.1",
        "typescript": "^5.9.3"
    }
}
